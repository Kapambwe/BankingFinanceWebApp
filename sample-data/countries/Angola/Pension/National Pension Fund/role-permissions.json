      "permissions": [
        "Banking.Pension.Contributions.View",
        "Banking.Pension.Contributions.Manage"
      ]
    },
    {
      "roleName": "EnrollmentOfficer",
      "permissions": [
        "Banking.Pension.Enrollment.View",
        "Banking.Pension.Enrollment.Manage",
        "Banking.Pension.Contributions.View"
      ]
    },
    {
      "roleName": "PensionAdmin",
      "permissions": [
        "Banking.Pension.View",
        "Banking.Pension.Dashboard",
        "Banking.Pension.Contributions.View",
        "Banking.Pension.Contributions.Manage",
        "Banking.Pension.Benefits.View",
        "Banking.Pension.Benefits.Manage",
