        "Banking.Mortgage.Applications.View"
      ]
    },
    {
      "roleName": "MortgageAdmin",
      "permissions": [
        "Banking.Mortgage.View",
        "Banking.Mortgage.Dashboard",
        "Banking.Mortgage.Applications.View",
        "Banking.Mortgage.Applications.ManageApplications",
        "Banking.Mortgage.Applications.ApproveApplication",
        "Banking.Mortgage.Properties.View",
        "Banking.Mortgage.Properties.ManageProperties",
        "Banking.Mortgage.Properties.ManageValuations",
        "Banking.Loans.View",
        "Banking.Loans.Create",
        "Banking.Loans.Approve",
        "Banking.Documents.Manage"
