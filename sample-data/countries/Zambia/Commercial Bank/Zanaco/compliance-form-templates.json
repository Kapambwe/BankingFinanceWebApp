[
  {
    "id": "form-policy-exception",
    "code": "FORM-POLICY-EXCEPTION",
    "name": "Policy Exception Request",
    "purpose": "Collects approval data for policy overrides and temporary exceptions.",
    "owner": "Compliance",
    "status": "Active",
    "lifecycle": "Production-ready",
    "lastUpdated": "2026-06-11T08:00:00Z",
    "usedFor": [ "Credit policy exceptions", "Operational waivers" ],
    "sections": [
      {
        "title": "Request Details",
        "description": "Capture the exception, the control being overridden and the business justification.",
        "fields": [
          { "key": "requestorName", "label": "Requestor name", "type": "Text", "required": true, "placeholder": "Enter the requestor" },
          {
            "key": "controlArea",
            "label": "Control area",
            "type": "Select",
            "required": true,
            "options": [
              { "value": "credit", "label": "Credit" },
              { "value": "aml", "label": "AML" },
              { "value": "treasury", "label": "Treasury" },
              { "value": "operations", "label": "Operations" }
            ]
          },
          { "key": "businessJustification", "label": "Business justification", "type": "Multiline", "required": true, "placeholder": "Explain the exception" }
        ]
      },
      {
        "title": "Approval Details",
        "description": "Capture the intended expiry date and the approval routing.",
        "fields": [
          { "key": "expiryDate", "label": "Expiry date", "type": "Date", "required": true },
          { "key": "requiresBoardApproval", "label": "Requires board approval", "type": "Checkbox", "required": false }
        ]
      }
    ]
  },
